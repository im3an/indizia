{
  "name": "indizia",
  "version": "0.4.0",
  "private": true,
  "description": "Prototype of a free, source-transparent OSINT research engine: one box, cited findings, a coverage ledger.",
  "author": "Imran Moujtahid",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/vendor.mjs",
    "dev": "node server/node.mjs",
    "start": "node server/node.mjs",
    "test": "node --test test/*.test.js",
    "data": "node scripts/build-data.mjs",
    "deploy": "wrangler deploy",
    "dev:toolbox": "INDIZIA_TOOLBOX=1 node server/node.mjs",
    "desktop": "npm --prefix desktop start",
    "desktop:dist": "npm --prefix desktop run dist"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "diff": "9.0.0",
    "exifr": "7.1.3",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "libphonenumber-js": "1.13.14",
    "minisearch": "7.2.0",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "wrangler": "4.145.0"
  }
}
